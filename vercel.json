{
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/th", "destination": "/index.html" },
    { "source": "/th/(.*)", "destination": "/index.html" }
  ]
}
